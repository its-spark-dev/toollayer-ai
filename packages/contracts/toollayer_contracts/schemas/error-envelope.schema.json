{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.toollayer.example/v1/error-envelope.schema.json",
  "title": "ToolLayer Error Envelope",
  "description": "The single failure shape used by every ToolLayer HTTP API. Messages describe the failing rule and its location; they never echo the rejected value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A stable machine-readable code. Clients branch on this, never on the message."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "A short English explanation of the failing rule. Must not contain the rejected input value, a secret, or an internal hostname."
        },
        "pointer": {
          "type": ["string", "null"],
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "description": "RFC 6901 pointer to the offending location in the submitted document, when one applies."
        },
        "details": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 64 },
              "message": { "type": "string", "minLength": 1, "maxLength": 512 },
              "pointer": {
                "type": ["string", "null"],
                "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
              },
              "severity": { "type": "string", "enum": ["error", "warning"] }
            }
          },
          "description": "Per-item diagnostics for batch operations such as document analysis."
        },
        "request_id": { "type": ["string", "null"], "maxLength": 64 }
      }
    }
  }
}
