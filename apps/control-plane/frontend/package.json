{
  "name": "toollayer-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Admin console for the ToolLayer AI Tool Control Plane.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "sync:spec": "node scripts/sync-spec.mjs",
    "check:diagrams": "node scripts/check-mermaid.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "mermaid": "^11.16.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
