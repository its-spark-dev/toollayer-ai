# Copy to .env and adjust. Every value here is a non-secret placeholder.
#
# The placeholders are obviously fake on purpose. A sample file that looks like a real
# credential is one that eventually gets deployed as if it were.

# ---------------------------------------------------------------------------------------
# Tool Control Plane
# ---------------------------------------------------------------------------------------

# SQLite by default so the demo needs no external service.
# PostgreSQL: postgresql+psycopg://toollayer:toollayer@localhost:5432/toollayer
TOOLLAYER_CONTROL_PLANE_DATABASE_URL=sqlite:///./data/control-plane.db

# Two audiences, two credentials. The admin token authors and publishes; the service token
# only reads snapshots. They must differ — the Control Plane refuses to start otherwise, so
# a leaked runtime credential can never publish anything.
TOOLLAYER_ADMIN_TOKEN=dev-admin-token-change-me
TOOLLAYER_SERVICE_TOKEN=dev-service-token-change-me

TOOLLAYER_CONTROL_PLANE_CORS_ORIGINS=http://localhost:5173
TOOLLAYER_MAX_SOURCE_BYTES=2097152

# --- Snapshot signing ---------------------------------------------------------------------
# The private half of an Ed25519 pair, base64url. The Control Plane signs every snapshot with
# it so a runtime can tell an artifact this service produced from one an attacker substituted.
# The digest cannot do that: computing SHA-256 needs no secret.
#
# There is deliberately no value here. Generate a pair instead:
#     python scripts/generate_signing_key.py --key-id demo-signing-key
# `make demo` and `make demo-docker` do that automatically, per run, in memory. A committed
# development key is a credential-shaped object that eventually gets deployed as if it were one.
#
# Leaving these empty publishes unsigned snapshots, which the runtime below refuses unless it
# too is explicitly put in unsigned mode.
TOOLLAYER_SNAPSHOT_SIGNING_KEY=
TOOLLAYER_SNAPSHOT_SIGNING_KEY_ID=

# ---------------------------------------------------------------------------------------
# LLM Orchestration Runtime
# ---------------------------------------------------------------------------------------

TOOLLAYER_CONTROL_PLANE_URL=http://localhost:8080
TOOLLAYER_DEPLOYMENT_KEY=demo-workspace
TOOLLAYER_SNAPSHOT_REFRESH_SECONDS=60

# The destinations this runtime may contact, as exact origins, comma separated.
# There is no wildcard. An empty value permits nothing, which is the default.
TOOLLAYER_ALLOWED_ORIGINS=http://localhost:8081

# --- Destination escape hatches -----------------------------------------------------------
# All three are OFF by default and should stay off outside local development. They exist
# because the demo API runs on localhost over plaintext HTTP; a real upstream would be an
# HTTPS service on a routable address and would need none of them.
#
# TOOLLAYER_ALLOW_PLAINTEXT_HTTP  permit http:// destinations as well as https://
# TOOLLAYER_ALLOW_LOOPBACK_DESTINATIONS  permit destinations resolving to 127.0.0.0/8 or ::1
# TOOLLAYER_ALLOW_PRIVATE_ADDRESSES  permit destinations resolving to non-routable addresses
#
# Link-local addresses (169.254.0.0/16, where cloud instance metadata lives) are refused
# unconditionally. No setting enables them. IPv4-mapped IPv6 forms such as ::ffff:127.0.0.1 are
# unwrapped first, so they are judged as the address they actually reach.
#
# The values below are what a *local* run needs, not the application defaults: two of the three
# are overridden to true here because the demo API is plaintext HTTP on localhost.
TOOLLAYER_ALLOW_PLAINTEXT_HTTP=true
TOOLLAYER_ALLOW_LOOPBACK_DESTINATIONS=true
TOOLLAYER_ALLOW_PRIVATE_ADDRESSES=false

# Outbound request bounds. Every one has a finite default; these only narrow them. The byte cap
# is enforced while the response is being read, so it bounds memory and not just the result.
TOOLLAYER_CONNECT_TIMEOUT_SECONDS=3.0
TOOLLAYER_READ_TIMEOUT_SECONDS=10.0
TOOLLAYER_MAX_RESPONSE_BYTES=1048576

# --- Snapshot verification ------------------------------------------------------------------
# The public half, as `key_id:base64url_public_key`. Several entries, comma separated, so a key
# rotation does not need the Control Plane and every runtime to change in the same instant.
TOOLLAYER_SNAPSHOT_TRUSTED_KEYS=

# `required` (the default) or `disabled`. No other spelling is accepted — a mode this service
# cannot parse is one it refuses to start with, rather than one it guesses at. `disabled` exists
# for the offline demonstration, is never implicit, and is reported by /healthz.
TOOLLAYER_SNAPSHOT_VERIFICATION=required

# --- Caller identity --------------------------------------------------------------------------
# `asserted_header` (the default) reads x-toollayer-caller and x-toollayer-roles and believes
# them. That is a demonstration convenience, not authentication: anything that can reach the
# runtime can claim any role. /healthz reports `caller_identity_is_verified: false` so a
# deployment cannot be in this mode quietly.
#
# `verified_token` requires a signed caller token (compact JWS, EdDSA over Ed25519) and checks
# the signature, issuer, audience and expiry before deriving a subject and roles. The assertion
# headers are refused outright in that mode. All three settings below are then mandatory.
TOOLLAYER_CALLER_AUTH_MODE=asserted_header
TOOLLAYER_CALLER_TOKEN_TRUSTED_KEYS=
TOOLLAYER_CALLER_TOKEN_ISSUER=
TOOLLAYER_CALLER_TOKEN_AUDIENCE=

TOOLLAYER_RUNTIME_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------------------
# Console
# ---------------------------------------------------------------------------------------

VITE_CONTROL_PLANE_URL=http://localhost:8080
VITE_RUNTIME_URL=http://localhost:8082
VITE_ADMIN_TOKEN=dev-admin-token-change-me
